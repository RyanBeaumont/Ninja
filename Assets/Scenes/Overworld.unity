  dialog:
  - text: Unnnggghhh
    name: Spartan Jack
    character: {fileID: 1969696369}
    pose: Defeated
    cameraAngle: 0
    face: Angry
  - text: Owwwww...
    name: Big Sam
    character: {fileID: 1732529860}
