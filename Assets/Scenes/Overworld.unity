  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: YOU!!!
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Objection
    cameraAngle: 6
    face: Mad
  - text: Me?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Blank
  - text: You go to YOU-JUTSU. That's our RIVAL DOJO!
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Idle
    cameraAngle: 7
    face: Angry
  - text: That makes you... my RIVAL
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: ArmsCrossed
    cameraAngle: 7
    face: Mad
  - text: That means we have to, like, fight now, or something...
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: I think. I dunno man, I'm new here
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Embarrassed
    cameraAngle: 0
    face: Explaining
  turnToFace: 0
  snapPlayerPosition: 1
