--- !u!114 &1771011392103860918
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4841343756570854651}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: All of a sudden...
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: This was the moment that you would never be able to explain, the moment
      that set you on a path of intrigue which you would never return from...
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: You have heard stories about the great weapons of great families, and the
      powers they contain. But you knew that your family didn't come from greatness.
      Your sword was blunt and powerless. Until it began to glow
    name: 
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 0
    face: Confused
  - text: It began to spark with power, and all of a sudden you saw...
    name: 
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 6
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 1
