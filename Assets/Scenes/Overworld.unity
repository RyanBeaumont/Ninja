  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Hey, lil guy...

      You''re kinda cute'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  - text: Baaaa
    name: Ghostly Sheep
    character: {fileID: 1033331741}
    pose: 
    cameraAngle: 13
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
