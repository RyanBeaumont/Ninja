  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Alright, slowpoke...

      Time to go adventuring!'
    name: Torch
    character: {fileID: 2066147006}
    pose: HandsOnHips
    cameraAngle: 4
    face: Happy
  - text: Hey now, a dojo girl needs her time to get ready
    name: Storm
    character: {fileID: 0}
    pose: Sassy
    cameraAngle: 3
    face: Confused
  - text: We need to look all around for Spartan Jack... He could be hiding anywhere.
    name: Torch
    character: {fileID: 2066147006}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Confused
  - text: Any leads, Sherlock?
    name: Storm
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Confused
  - text: 'If I was Spartan Jack... I''d go somewhere we''d least expect.

      The
      Fight Club, maybe? Or, I know there are some secret hideouts deeper in the
      forest'
    name: Torch
    character: {fileID: 2066147006}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Confused
  - text: 'We should also check the rival dojo...

      Something''s fishy about
      that place, I can smell it'
    name: Storm
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
