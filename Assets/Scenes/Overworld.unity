--- !u!114 &1692691708
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1692691698}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: ...And this guy just comes out of nowhere and we start having this fight
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: All of this flying kung fu, I was like, kachow...
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Explaining
    cameraAngle: 0
    face: Angry
  - text: You look... pretty beat up
    name: Spartan No-Belt
    character: {fileID: 1678734792}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: The price of victory, my man. You should've seen the other guy
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Embarrassed
    cameraAngle: 0
    face: Happy
  - text: Wait a second... THERE HE IS!
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Objection
    cameraAngle: 5
    face: Mad
  - text: Do you... need my help on this one?
    name: Spartan No-Belt
    character: {fileID: 1678734792}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: Please, I beg you
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
