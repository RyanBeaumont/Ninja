--- !u!114 &1033331747
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1033331740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Getting near the sheep gave you a bizarre feeling of familiarity... Like
      you've seen it before. Like it's always been a part of your life...
    name: 
    character: {fileID: 1033331741}
    pose: 
    cameraAngle: 5
    face: 
  - text: But before you could investigate it further, your sword stopped glowing
    name: 
    character: {fileID: 0}
    pose: Sheath
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
