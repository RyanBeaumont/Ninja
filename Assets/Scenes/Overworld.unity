--- !u!114 &1693674166
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1693674155}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Heya. Spartan Jack!
    name: Stretch
    character: {fileID: 1693674154}
    pose: HandsOnHips
    cameraAngle: 0
    face: Happy
  - text: Wow, he came.
    name: Thad
    character: {fileID: 1387872096}
    pose: CasualLean
    cameraAngle: 0
    face: Confused
  - text: You owe me a dollar, Thad
    name: Stretch
    character: {fileID: 1693674154}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "Dang it Spartan, do you have any self preservation instincts at all? You\u2019re
      gonna get yourself kidnapped coming to the forest just because a cute girl
      says so"
    name: Thad
    character: {fileID: 1387872096}
    pose: CasualLean
    cameraAngle: 0
    face: Confused
  - text: "Well, it looks like it worked on you too\u2026 Plus I have this to protect
      me\r\n"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 0
    face: Happy
  - text: "It\u2019s tai chi time, are we gonna find inner peace or what?\r\n"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Sheath
    cameraAngle: 0
    face: Confused
  - text: Umm Spartan Jack, I brought you here to do just about the opposite
    name: Stretch
    character: {fileID: 1693674154}
    pose: Sass
    cameraAngle: 0
    face: Confused
  - text: Inner... Violence? I'm listening
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: Exactly! Stretch, are we ready to do the thingy?
    name: Thad
    character: {fileID: 1387872096}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  - text: "I\u2019m always ready for a ritual. Spartan, are you ready to learn the
      true power of that blade you've got? Follow me!"
    name: Stretch
    character: {fileID: 1693674154}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  turnToFace: 1
  snapPlayerPosition: 1
