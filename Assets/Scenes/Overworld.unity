  snapPlayerPosition: 0
--- !u!114 &1078865910
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078865890}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Did we just...
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "She just\u2026 disappeared into dust\r\n"
    name: Stretch
    character: {fileID: 1465752566}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "This is getting way over our heads\u2026 One day we were friends, and
      the next she\u2019s..\r\n"
    name: Stretch
    character: {fileID: 1465752566}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "If I start thinking about it now\u2026 \nNo\u2026 \r\n"
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 2
    face: Dissapointed
  - text: "I never meant for it to get this far\u2026\nJade was my... IS my sister...\r\n"
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 2
    face: Surprised
  - text: 'We need to focus. These enemies of ours aren''t gonna stop just because
      we keep fighting each other--

      In fact, if they saw anything that happened
      this week, they might find it the perfect time to strike, now that--

'
    name: Stretch
    character: {fileID: 1465752566}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: 'Is Jade... Dead?

      What... Happened to her?'
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'I''m not sure anyone could have survived that...

      She attacked us
      with lethal force, and... I wasn''t even thinking

      I let out my rage'
    name: Storm
    character: {fileID: 1939439166}
    pose: Meditating
    cameraAngle: 4
    face: Dissapointed
  - text: 'Storm, you and I both knew Jade was bad news.

      I didn''t want things
      to end this way, but it was gonna end in pain one way or another...'
    name: Stretch
    character: {fileID: 1465752566}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Dissapointed
  - text: We just have to make sure that all this wasn't for nothing
    name: Stretch
    character: {fileID: 1465752566}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Mad
  - text: "Where\u2019s Spartan Jack? We need to find him\r\n"
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "Definitely. As much as I hate to admit it, Jade was right about the sword.
      And Spartan Jack can\u2019t be trusted with this knowledge. We need to find
      him before he tells anyone\r\n"
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 2
    face: Surprised
  - text: "You girls keep talking about some big \u201Csecret\u201D\u2026 What is
      it??\r\n"
    name: Thad
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: "If you needed to know, we would\u2019ve told you."
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: "It's a secret.\nlike, obviously. \nC'mon man how many times do we have
      to say that"
    name: Stretch
    character: {fileID: 1465752566}
    pose: HandsOnHips
    cameraAngle: 2
    face: Mad
  - text: "So\u2026 What are you planning to do to Spartan Jack after you catch him?
      I mean, it\u2019s not like you\u2019re going to KILL him like Jade wanted\u2026"
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "I\u2026 think there\u2019s only one other way\u2026\r\n"
    name: Storm
    character: {fileID: 1939439166}
    pose: Idle
    cameraAngle: 2
    face: Surprised
  - text: We need to make him an Insider.
    name: Storm
    character: {fileID: 1939439166}
    pose: Idle
    cameraAngle: 3
    face: Surprised
  - text: "We haven\u2019t trained a new one in years.. And with every new person
      we train, the chance of the secret getting out goes up. Not only that, but
      Jack was attacked once already, just ONE DAY after learning it exists. Making
      him an Insider would only raise his danger\u2026"
    name: Stretch
    character: {fileID: 1465752566}
    pose: Idle
    cameraAngle: 2
    face: Confused
  - text: "I know\u2026 But it\u2019s the only choice we\u2019ve got. We were trained
      to protect.\nI swore an oath, Stretch.\nAnd if the threat against us is growing,
      we need more friends on our side.\r\n"
    name: Storm
    character: {fileID: 1939439166}
    pose: Idle
    cameraAngle: 3
    face: Confused
  - text: "The prospect of being an INSIDER excites you. You don\u2019t quite know
      what it means, but it sounds pretty rad.\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: "Stretch, watch them closely. Make sure the knowledge doesn\u2019t spread.
      I\u2019m calling a meeting tomorrow at midnight. An INITIATION"
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 3
    face: Confused
  - text: 'Thad, you better show up.

      ALL will be revealed'
    name: Storm
    character: {fileID: 1939439166}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: About time!
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
