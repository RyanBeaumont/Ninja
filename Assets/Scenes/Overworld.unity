--- !u!114 &1078865900
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078865890}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Oh, we have a problem alright
    name: Storm
    character: {fileID: 1939439166}
    pose: Sassy
    cameraAngle: 3
    face: Disappointed
  - text: 'We were never supposed to kill Spartan Jack--

      We were never supposed
      to kill anyone!'
    name: Storm
    character: {fileID: 1939439166}
    pose: Sassy
    cameraAngle: 3
    face: Mad
  - text: We are protectors, Jade. Not killers
    name: Storm
    character: {fileID: 1939439166}
    pose: Sassy
    cameraAngle: 2
    face: Mad
  - text: 'You''re right, Storm.

      And if we don''t keep our secrets  secret...

      People
      will come for us'
    name: Jade
    character: {fileID: 1779771471}
    pose: Sassy
    cameraAngle: 2
    face: Mad
  - text: 'More than just a few kids.

      Letting the secret out was YOUR mistake,
      Storm. And this is how we have to fix it'
    name: Jade
    character: {fileID: 1779771471}
    pose: Idle
    cameraAngle: 2
    face: Surprised
  - text: Better to end this now, before it all flies off the handle
    name: Jade
    character: {fileID: 1779771471}
    pose: Idle
    cameraAngle: 2
    face: Surprised
  turnToFace: 0
  snapPlayerPosition: 0
