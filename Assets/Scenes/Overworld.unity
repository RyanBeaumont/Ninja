--- !u!114 &2083225933
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2083225929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: This is a nice little piece. A gift shop souvenir? Or a family weapon
    name: Storm
    character: {fileID: 958467053}
    pose: Unsheath
    cameraAngle: 0
    face: Happy
  - text: I'll kill you!
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Mad
  - text: Oh, is this important to you?
    name: Storm
    character: {fileID: 958467053}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: Pssht
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: It must have some sort of power then?
    name: Storm
    character: {fileID: 958467053}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: "Oh yeah, the power to go all the way up your\u2013"
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Mad
  - text: "Let\u2019s see what this thing can do"
    name: Storm
    character: {fileID: 958467053}
    pose: BoTwirl
    cameraAngle: 7
    face: Mad
  - text: "YOU\u2019RE CRAZY, LADY"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 4
    face: Surprised
  - text: "I\u2019ll be keeping this. If you want it back, you\u2019re gonna have
      to get strong. Maybe then I\u2019ll respect you"
    name: Storm
    character: {fileID: 958467053}
    pose: Sheath
    cameraAngle: 2
    face: Confused
  - text: "Have fun, it\u2019s a worthless piece of junk anyway"
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Angry
  - text: "(It might be a piece of junk but it\u2019s YOUR junk. No one touches your
      junk and lives to tell the tale. You decide you will lay low and train, and
      one day you will show her what true strength is)"
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Angry
  - text: Sayonara, loser
    name: Storm
    character: {fileID: 958467053}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Surprised
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &2083225934
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2083225929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: (Oh, good lord. It's her)
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 5
    face: Happy
  - text: "We meet again.\nLearning to defend yourself? That\u2019s cute"
    name: Storm
    character: {fileID: 958467053}
    pose: Sassy
    cameraAngle: 3
    face: Confused
  - text: What are you doing here?
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Angry
  - text: 'Oh puh-lease.

      I''m the Sensei''s daughter. I practically live here'
    name: Storm
    character: {fileID: 958467053}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Confused
  - text: (You fear you have made a most terrible mistake, signing a year contract
      with her father's dojo)
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 4
    face: Confused
  - text: "I see my father really just takes anyone in nowadays.. But now you get
      to spar with me - and I don\u2019t see your knight in shining armor this time"
    name: Storm
    character: {fileID: 958467053}
    pose: Sassy
    cameraAngle: 3
    face: Confused
  - text: What do you want with me?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 2
    face: Angry
  turnToFace: 0
  snapPlayerPosition: 0
