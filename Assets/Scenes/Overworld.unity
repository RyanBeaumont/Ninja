--- !u!114 &77815502
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 77815495}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You are about to enjoy the one and only peaceful time of the day when suddenly...
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'OY!

      You''re the one beating up all my students, arent you!'
    name: Rival Sensei
    character: {fileID: 77815496}
    pose: ArmsCrossed
    cameraAngle: 6
    face: Mad
  - text: '(You look around)

      Who... Me?'
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Blank
  - text: 'Yes, you! You got promise, kid!

      Someone''s gotta shape these students
      up, and it was gonna be me, but... You seem to have got to ''em first.'
    name: Rival Sensei
    character: {fileID: 77815496}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: 'I''m so impressed with you, I tell you what...

      I''m gonna give
      you a PRIVATE LESSON!

      Whaddaya say, do you want to know what it''s like
      to be a TRUE Spartan?'
    name: Rival Sensei
    character: {fileID: 77815496}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 1
