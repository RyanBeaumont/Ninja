--- !u!114 &1033331751
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1033331740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You hear two voices in the yard, their tone serious. You squint your eyes,
      unable to make out anything
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: '"This isn''t what I asked for". This one is male, deep. An adult'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: '"What do you mean? It''s perfect". A girl''s voice, not much older than
      you'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: '"It''s a fake"'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: The girl sighs and says, "Come closer"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: ...You struggle to hear the conversation. Peering through the crack, you
      can only make out two shadows
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: You hear... The sound of a fist hitting a skull. The shuffle of clothing.
      An ear piercing scream, suddenly covered by a hand.
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: And suddenly, silence. Where did the figures go? If only you could find
      a way into the yard
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: '(Tip: You can double-jump and grab onto rooftop ledges)'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1033331752
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1033331740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: '...And something else started glowing.

      You can see it through the
      crack in the fence.'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: Could this be what the eerie glowing sheep was trying to lead you to?
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1033331753
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1033331740}
