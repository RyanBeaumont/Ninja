  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You see a scroll tied to a tree...
    name: 
    character: {fileID: 1063102851}
    pose: HandsOnHips
    cameraAngle: 5
    face: 
  - text: 'WANTED: "Spartan" Jack

      HIGHLY DANGEROUS CRIMINAL

      IF SEEN,
      REPORT TO THE SPARTAN DOJO'
    name: 
    character: {fileID: 1063102851}
    pose: HandsOnHips
    cameraAngle: 5
    face: 
  - text: 'BOUNTY: 500 GOLD'
    name: 
    character: {fileID: 1063102851}
    pose: HandsOnHips
    cameraAngle: 5
    face: 
  - text: Dang. You wish you were worth 500 gold.
    name: 
    character: {fileID: 1063102851}
    pose: HandsOnHips
    cameraAngle: 2
    face: Surprised
  - text: 'Um, guys?

      It looks like we''re not the only ones on the hunt for
      Spartan Jack'
    name: Storm
    character: {fileID: 1063102851}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 1
