--- !u!114 &718702539
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 718702536}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: oh my god storm you are a godsend
    name: Nova
    character: {fileID: 718702535}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: i would've been here all day climbing trees like some sort of deranged
      monkey
    name: Nova
    character: {fileID: 718702535}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: 'oh yeah i was gonna give you a prize...

      the prize is, not having
      to deal with me.

      oh, and hella gold'
    name: Nova
    character: {fileID: 718702535}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: 'courtesy of the ninja council. but they don''t know it''s gone yet

      and
      if they did, they wouldn''t know it was me.

      Nova, OUT'
    name: Nova
    character: {fileID: 718702535}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: Wha... Did she just vanish into a puff of smoke?
    name: Storm
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Surprised
  turnToFace: 0
  snapPlayerPosition: 0
