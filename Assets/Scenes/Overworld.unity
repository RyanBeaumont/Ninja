--- !u!114 &582867647
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 582867623}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: What the heck, man
    name: Spartan Jack
    character: {fileID: 1969696369}
    pose: Defeated
    cameraAngle: 13
    face: Mad
  - text: Not much of a Spartan, I see. You really need to work on your balance
    name: Storm
    character: {fileID: 273000095}
    pose: HandsOnHips
    cameraAngle: 3
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &582867649
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 582867623}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Oh it\u2019s the new kid\u2026 coming home from school all alone?"
    name: Storm
    character: {fileID: 273000095}
    pose: Sassy
    cameraAngle: 0
    face: Happy
  - text: Actually I'm on my way back from yo momma's house
    name: Spartan Jack
    character: {fileID: 1969696369}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'Heh.. Heh heh.

      Want some company?

      The name''s Storm, by
      the way'
    name: Storm
    character: {fileID: 273000095}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: 'S... Sure?

      I''m Jack. Spartan Jack.'
    name: Spartan Jack
    character: {fileID: 1969696369}
    pose: Embarrassed
    cameraAngle: 0
    face: Happy
  - text: 'So I''ve heard.

      You think you''re real tough, huh?'
    name: Storm
    character: {fileID: 273000095}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'Yes ma''am.

      The genuine article.'
    name: Spartan Jack
    character: {fileID: 1969696369}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: We'll see about that
    name: Storm
    character: {fileID: 273000095}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &582867651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
