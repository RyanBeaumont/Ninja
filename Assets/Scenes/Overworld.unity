--- !u!114 &1078865898
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078865890}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Oh, there you guys are...

      What...

      Did I walk into...'
    name: Stretch
    character: {fileID: 1465752566}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: 'Jade is insane, man--

      She''s trying to--'
    name: Thad
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Surprised
  - text: 'Jade, listen to me.

      "it" has already flown "off the handle"...

      It''s
      not just Spartan Jack, Thad or this  mysterious other kid with a voice changer
      we have to worry about'
    name: Stretch
    character: {fileID: 1465752566}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Mad
  - text: 'Two nights ago, a man from the dojo across the street came to me demanding
      the sword.

      The secret is already out'
    name: Stretch
    character: {fileID: 1465752566}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: 'That''s it...

      This ends now'
    name: Jade
    character: {fileID: 1779771471}
    pose: Embarrassed
    cameraAngle: 3
    face: Mad
  - text: 'Jade...

      You''re not thinking straight'
    name: Stretch
    character: {fileID: 1465752566}
    pose: Unsheath
    cameraAngle: 2
    face: Mad
  - text: 'Thad, Stretch,

      Get behind me'
    name: Storm
    character: {fileID: 1939439166}
    pose: Unsheath
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1078865899
