  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: MP? Super gauge? What the heck is any of this?
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: Beats me
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 3
    face: Confused
  - text: I should've paid more attention in class... Ugh. Now I gotta explain all
      these bruises. Truce?
    name: Spartan No-Belt
    character: {fileID: 1677283609}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: Yeah, whatever
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 1
--- !u!114 &1677283603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1677283599}
