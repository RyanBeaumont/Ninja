--- !u!114 &1692691702
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1692691698}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Ugh.. You can have all my... Well, my lunch money was already stolen. You
      can have my soda
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Defeated
    cameraAngle: 0
    face: Confused
  - text: Just don't tell Sensei
    name: Spartan No-Belt
    character: {fileID: 1678734792}
    pose: Defeated
    cameraAngle: 0
    face: Confused
  - text: We're not allowed to get our first belt until we win a street fight
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: Have you tried... fighting each other?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 5
    face: Confused
  - text: That would certainly be more productive than fighting you
    name: Spartan No-Belt
    character: {fileID: 1419681113}
    pose: Defeated
    cameraAngle: 0
    face: Blank
  turnToFace: 0
  snapPlayerPosition: 0
