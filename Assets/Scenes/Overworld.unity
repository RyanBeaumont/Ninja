--- !u!114 &1414783447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1414783438}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Ungghh... Nice try...
    name: 
    character: {fileID: 770400198}
    pose: Defeated
    cameraAngle: 13
    face: Mad
  - text: That's all I get? For defeating the master's daughter? Nice try?
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'But you didn''t...

      Look...

      Behind you...'
    name: Storm
    character: {fileID: 770400198}
    pose: Defeated
    cameraAngle: 13
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1414783449
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1414783438}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: S... Storm? It's midnight - what are you doing here?
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'I practically live here. My dad is the master here, if you didn''t know.

      The
      real question is... What are YOU doing here?'
    name: Storm
    character: {fileID: 770400198}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Mad
  - text: I... Umm... I left my... coca cola...
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 4
    face: Blank
  - text: Wow. Impressive. Bravo. An acting master class.
    name: Storm
    character: {fileID: 770400198}
    pose: Sassy
    cameraAngle: 3
    face: Confused
  - text: 'And for the record, what I''m doing here...

      Is stopping you.'
    name: Storm
    character: {fileID: 770400198}
    pose: HandsOnHips
    cameraAngle: 3
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 1
