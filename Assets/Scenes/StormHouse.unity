  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Your name is STORM. You are the daughter of the GRANDMASTER, and a LEVEL
      5 PSYCHIC.
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: You have a lot on your mind... but you're not quite sure what to do. Perhaps
      there is TOO much to do, and you can't decide what to do first.
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: 'You decide to catch up with your friend TORCH and the SAFE CLUB in the
      dojo. You make that your QUEST.

'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: Maybe he can help you look for Spartan Jack... Besides his house, where
      could he even be?
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
