  - text: "No, hold up\u2026 I hear something\u2026"
    name: Storm
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: Mad
  - text: "(You don\u2019t hear a thing. This might just be Storm\u2019s last-ditch
      attempt at keeping you from escaping. You know you have the speed\u2026 but\u2026)"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "(Suddenly, the air begins to crackle with energy\u2026)"
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 3
    face: Blank
  - text: "(Disregarding all sense of sanity, you continue to stand in place like
      an imbecile. And all of a sudden\u2026)"
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 3
    face: Blank
  turnToFace: 0
  snapPlayerPosition: 0
