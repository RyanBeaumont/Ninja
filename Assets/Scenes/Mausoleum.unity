  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: IMMEDIATELY, ROSE CAME TO HER SENSES, AND FELL TO HER KNEES
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'THIS WAS NOT TRUE STRENGTH, THIS WAS MURDER. THIS WAS WEAKNESS TO A MENTAL
      STATE SHE COULD NOT CONTROL. '
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: AND SO, WHEN HER SISTER CRYSTAL FINALLY REACHED THE MOUNTAINTOP, ROSE DECLARED
      HERSELF UNWORTHY AND SET KHAN DOWN. THE SWORD WAS CRYSTAL'S TO INHERIT
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: LITTLE DID ROSE KNOW, BUT THOSE KILLING THOUGHTS BELONGED TO CRYSTAL -
      A MENTAL TRICK SHE HAD BEEN HONING FOR YEARS FOR THIS CRITICAL MOMENT
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 1
