--- !u!114 &28385264
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 28385263}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: OVERCOME WITH GRIEF, ROSE EXILED HERSELF FROM THE GRANDMASTER'S FAMILY
      AND RAN FAR AWAY. SHE WENT ON TO START A LIFE OF HER OWN, AND HAVE A CHILD.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: SHE NAMED THE BOY "SPARTAN" JACK, AND VOWED TO RAISE HIM AS THE STRONGEST
      WARRIOR THIS WORLD HAS EVER SEEN.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: SHE KNEW THAT PSYCHIC INFLUENCE RELIES ON CONNECTION, SO SHE MADE SURE
      TO MOVE EVERY YEAR TO ENSURE JACK WOULD NOT FORM ANY ATTACHMENTS
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: 'SHE BLAMED THE NINJA FOR THIS. BUT THE NINJA JUST SAT BACK AND WATCHED. '
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 1
