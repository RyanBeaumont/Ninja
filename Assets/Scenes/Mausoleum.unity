  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: THE GRANDMASTER DID NOT BELIEVE IN BIRTHRIGHT - HE WOULD NOT SIMPLY GIVE
      THE FAMILY SWORD AWAY IN HIS OLD AGE. INSTEAD, HE GATHERED HIS TEENAGE DAUGHTERS
      AND HELD A CONTEST
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: HE HID THE BLADE, NAMED KHAN, ATOP THE TALLEST MOUNTAIN IN THE VILLAGE.
      THE CONTEST HAD NO RULES
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: THE THREE DAUGHTERS STARTED ON DIFFERENT SIDES OF THE MOUNTAIN, EACH ARMED
      TO THE TEETH. THEY EACH KEPT THEIR GUARD UP, KNOWING THAT KILLING WAS NOT BENEATH
      THEM.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 1
