--- !u!114 &1900154585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1900154584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: DECADES AGO, THE LAST OF THE GREAT GRANDMASTERS HAD THREE DAUGHTERS, EACH
      TO THREE DIFFERENT WIVES
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: ONE OF THESE DAUGHTERS, ROSE, WAS A MASTER OF THE PHYSICAL ARTS - SHE HARDENED
      HER BODY LIKE STEEL AND PERFECTED A STYLE OF FIGHTING KNOWN AS THE SPARTAN
      WAY.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: THE SECOND DAUGHTER, CRYSTAL,  WAS A MASTER OF THE MIND, A WARRIOR SKILLED
      IN DECEPTION AND MIND CONTROL.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: THE THIRD, NOVA, HAD NO GIFTS. KNOWING HER CLAIM TO THE SWORD WAS WEAK,
      SHE TOOK TO THE SHADOWS AND SHOWED HER INFLUENCE ONLY THROUGH HER NETWORK OF
      HIDDEN NINJA
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  turnToFace: 0
  snapPlayerPosition: 1
