--- !u!114 &7095386176128879874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3342594783103442814}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Hey...

      Do you have any idea where we could find books on ancient
      Sparta...'
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: Or prophecies, or weapons or.. cults?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: Shhh
    name: Librarian
    character: {fileID: 7095386176128879872}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: You're the librarian... Isn't it your job to help out, or something?
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'No... Shhhh...

      (She begins typing on the computer and turns the
      screen toward you)'
    name: Librarian
    character: {fileID: 7095386176128879872}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: '"All those words in one sentence?

      Touchy subject, child"'
    name: 
    character: {fileID: 7095386176128879872}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  - text: 'She keeps typing.

      "I have a book you might like.

      But first
      I need a favor."'
    name: Librarian
    character: {fileID: 7095386176128879872}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: "\"Eight suspicious black books appeared here one day... \nCertainly ninja
      activity. Potentially bugged. I am afraid to move them\""
    name: Librarian
    character: {fileID: 7095386176128879872}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  - text: '"You find all eight books. You take out the bugs. Then I give you your
      book. You read in secret. Deal?"'
    name: Librarian
    character: {fileID: 7095386176128879872}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: (You nod your head silently)
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
