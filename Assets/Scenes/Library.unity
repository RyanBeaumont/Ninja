  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Without saying a word, the librarian hands you a golden book.

      The
      cover reads "THE SPARTAN MANIFESTO"'
    name: 
    character: {fileID: 7095386176128879872}
    pose: Explaining
    cameraAngle: 3
    face: 
  - text: 'Whoa...

      Are we ready for this?'
    name: Spartan Jack
    character: {fileID: 0}
