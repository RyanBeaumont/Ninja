  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Hey! Whatcha readin'?
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: Happy
  - text: the enthralling, scandalous and smokin hot tales of nonya
    name: Nova
    character: {fileID: 28543764}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: Nonya?
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: nonya business, creep.
    name: Nova
    character: {fileID: 28543764}
    pose: Sass
    cameraAngle: 2
    face: Confused
  - text: "Gee, thanks for nothing. Say, I know you\u2019re just supposed to observe
      but, could you give me any pointers? We\u2019re looking for ways to defeat
      Jade"
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: "i\u2019m not supposed to say this but.. ugh, the ninja better not be listening
      in\u2026"
    name: Nova
    character: {fileID: 28543764}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "i mean, if it\u2019s supposed to be common knowledge it shouldn\u2019t
      matter what I say or don't say anyway, right? ugh. whatever. here goes."
    name: Nova
    character: {fileID: 28543764}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: well there are more powerful soul blades than just the one you clowns are
      obsessing over
    name: Nova
    character: {fileID: 28543764}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 0
