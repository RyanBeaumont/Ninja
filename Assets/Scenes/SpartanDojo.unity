--- !u!114 &503156330
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 503156327}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Whoever was in charge of decorating this place did a great job. This is
      a Spartan's dream
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: You shove a couple ninja stars in your pocket, wave around the-- whatever
      this thing is--
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: But WAIT - you realize you probably shouldn't leave any trace. Besides
      the soda you already drank.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: Whoever uses this place is probably dangerous - and if it's Stretch? Dang.
      She's badder than you thought.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
