  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You see the master of this school, a man you know only as CHROME DOME.
      He turns to you... Uh oh...
    name: 
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 5
    face: 
  - text: "Hey \u2013 It\u2019s that girl who was SPYING on me! I DON\u2019T LIKE
      SPIES!!!"
    name: Chrome Dome
    character: {fileID: 1484589694}
    pose: ArmsCrossed
    cameraAngle: 6
    face: 
  - text: "Woah woah woah. Things aren\u2019t what they seem. I just want to join
      your dojo!\r"
    name: Storm
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  - text: Oh yeah? You think you can join our ELITE RANKS little girl? PROVE IT.
    name: Chrome Dome
    character: {fileID: 1484589694}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Mad
  - text: Chrome Dome crushes a can of Coca-Cola on his forehead just to insult you.
    name: Chrome Dome
    character: {fileID: 1484589694}
    pose: Drink
    cameraAngle: 3
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
