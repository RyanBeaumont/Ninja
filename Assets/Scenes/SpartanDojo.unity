  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'You recognize this weapon immediately...

      And your face turns to
      shock'
    name: 
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 5
    face: Surprised
  - text: 'It''s your sacred family sword-- Or at least, a replica.

      What is
      it doing here?

      You examine the hilt and find what you were looking for.
      A secret compartment.'
    name: 
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 3
    face: Surprised
  turnToFace: 0
  snapPlayerPosition: 0
