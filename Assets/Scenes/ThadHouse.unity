  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: 'Unnnngghh...

      So... Tired...

      Two... Hours... of Sleep...'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: '(You look over to see Stretch...

      Oh, great. She''s still real.

      But
      more importantly, she''s still asleep)

'
    name: 
    character: {fileID: 1967133386}
    pose: Defeated
    cameraAngle: 13
    face: Dissapointed
  - text: 'In your sleep, you connected a few dots...

'
    name: Thad
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: '#1) Last night in the cabin, Storm said that Spartan Jack "knew too much"...
      Stretch said it again in my room. He wasn''t just kidnapped for no reason -
      he knew something'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: A secret this mysterious cabal didn't want Jack, or you, to know about
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: '#2) Stretch didn''t say "Jade knocked him out"

      or even "Storm knocked
      him out"...

      She said "WE knocked them out"'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: 'Obviously, things got out of hand, and she needed some muscle like you.
      But the girl laying next to you is clearly not just here because she took a
      peek at your sweet abs or your knife collection.

'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: 'And that brings you to your grand conclusion,

      #4,

'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'You need to get away from Stretch,

      you need to do it now, while
      she''s still asleep,

      and you need to find Spartan Jack before any of
      these shady ninjas do'
    name: 
    character: {fileID: 994872486}
    pose: SittingDown
    cameraAngle: 7
    face: Confused
  - text: 'The clock is ticking, and you have a feeling you should start with his
      house

'
    name: 
    character: {fileID: 994872486}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
