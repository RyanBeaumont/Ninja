  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: "Stretch?? You're.. \nHow did you..."
    name: Thad
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: Break into the garage?
    name: Stretch
    character: {fileID: 2089959925}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: 'Easy...

      You left it unlocked.'
    name: Stretch
    character: {fileID: 2089959925}
    pose: HandsOnHips
    cameraAngle: 0
    face: Happy
  - text: Are you just gonna stand there or will you give me a ride in that sweet
      whip?
    name: Stretch
    character: {fileID: 2089959925}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'Finally!

      Someone appreciates the sheer dopeness of the party bus!'
    name: Thad
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  turnToFace: 1
