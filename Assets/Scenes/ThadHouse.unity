--- !u!114 &1210492123
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1210492119}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: 'Your name is THAD. You awake from your bed, an ominous dream still resonating
      through your head. '
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'It was a dream of Stretch... She was reaching out to you...

'
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: "Less of a dream\u2026 More like some kind of ESP\u2026\r\n"
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: "She said, \"I know you can\u2026 Hear me\u2026 Chosen One\u2026 Wake up\u2026
      Wake upppppp\u2026 HELP ME\u2026\"\r\n"
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: "You\u2019re glad it was just a dream. You check to make sure all of your
      abs are still there. Man are you thirsty\r\n"
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'New Quest: Get Water'
    name: 
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 5
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
