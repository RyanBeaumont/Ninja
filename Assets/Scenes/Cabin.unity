  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "You\u2019re not thinking straight! Storm, this isn\u2019t you!\r\n"
    name: Stretch
    character: {fileID: 181594438}
    pose: Explaining
    cameraAngle: 2
    face: Mad
  - text: "*Ungghhh* I\u2019m getting an awful headache. Let\u2019s get this over
      with.\r\n"
    name: Storm
    character: {fileID: 1993290824}
    pose: Embarrassed
    cameraAngle: 3
    face: Disappointed
  - text: No! Storm!
    name: Stretch
    character: {fileID: 181594438}
    pose: Explaining
    cameraAngle: 2
    face: Mad
  - text: 'Stay out of this...

      Go find the other one who got away'
    name: Storm
    character: {fileID: 1993290824}
    pose: Unsheath
    cameraAngle: 4
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
