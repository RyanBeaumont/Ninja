--- !u!114 &419053734
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 419053731}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'You awaken to a mysterious chamber...

      And struggle against the
      ropes binding you'
    name: 
    character: {fileID: 1923886051}
    pose: SittingDown
    cameraAngle: 4
    face: Angry
  - text: 'Oh, good.

      You''re awake'
    name: Storm
    character: {fileID: 176893421}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: 'There was another who broke into the dojo--

      A kid.'
    name: Storm
    character: {fileID: 176893421}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Mad
  - text: Tell me who it was and you don't have to die
    name: Storm
    character: {fileID: 176893421}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Disappointed
  - text: 'Die??!

      Isn''t that a little... Excessive? We''re f-- friends, right?'
    name: Spartan Jack
    character: {fileID: 1923886051}
    pose: SittingDown
    cameraAngle: 4
    face: Surprised
  - text: "Tell me who he was, Jack! If I had my say, you wouldn\u2019t die\u2026\r\nBut
      it\u2019s not up to me. It\u2019s up to the Boss \u2013\r\n"
    name: Storm
    character: {fileID: 176893421}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Surprised
  - text: 'Sensei?

'
    name: Spartan Jack
    character: {fileID: 1923886051}
    pose: SittingDown
    cameraAngle: 3
    face: Surprised
  - text: "My father isn\u2019t involved. This operation is between me, Stretch,
      and\u2026\r\n"
    name: Storm
    character: {fileID: 176893421}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Surprised
  turnToFace: 1
  snapPlayerPosition: 0
