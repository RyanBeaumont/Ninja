--- !u!114 &763555214
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 763555204}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "I can\u2019t do this. I know my orders, but\u2026\r\n"
    name: Storm
    character: {fileID: 763555205}
    pose: Idle
    cameraAngle: 4
    face: Sigh
  - text: "I\u2019m sorry, Jade\r\n"
    name: Storm
    character: {fileID: 763555205}
    pose: Idle
    cameraAngle: 4
    face: Sigh
  - text: 'Jade???

'
    name: Spartan Jack
    character: {fileID: 1320155966}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: "It\u2019s best you don\u2019t know. The more you learn, the more you\u2019ll
      become a target."
    name: Storm
    character: {fileID: 1993290824}
    pose: Idle
    cameraAngle: 4
    face: Confused
  - text: Spartan Jack, you need to get out of here. Now!
    name: Storm
    character: {fileID: 1993290824}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Mad
  - text: "And Jade, if you can hear me\u2026"
    name: Storm
    character: {fileID: 1993290824}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: 'YOU CANNOT CONTROL ME, DO YOU HEAR ME?!

      I WILL NOT BEND TO YOUR
      WILL ANY LONGER

'
    name: Storm
    character: {fileID: 1993290824}
    pose: HandsOnHips
    cameraAngle: 3
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
