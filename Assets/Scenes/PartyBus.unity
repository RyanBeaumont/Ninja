--- !u!114 &1303904719
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1303904717}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: THAT'S MY JAM!
    name: Thad
    character: {fileID: 1303904716}
    pose: Dance1
    cameraAngle: 0
    face: Happy
  - text: WHOOOOHOO!
    name: Stretch
    character: {fileID: 1442992734}
    pose: Dance2
    cameraAngle: 3
    face: 
  - text: (Storm, Stretch and Torch begin to awkwardly jiggle along. You are too
      busy reading the documents to even notice, let alone join in)
    name: 
    character: {fileID: 916619471}
    pose: Dance1
    cameraAngle: 0
    face: Happy
  - text: "Soon, you and the S.A.F.E. club are going to have another job to do \u2013
      a job to find your place in this new world."
    name: Spartan Jack
    character: {fileID: 1646508686}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: But for now, all you want to do is read about the other legendary weapons
      out there, and the mystical powers that have suddenly appeared throughout your
      world.
    name: Spartan Jack
    character: {fileID: 1646508686}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
