  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Man, it''s dark...

      I can barely see the road'
    name: Thad
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: Maybe if you took off your shades, dummy
    name: Stretch
    character: {fileID: 1319330905}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'I''m sorry, the shades are non-negotiable.

      These eyes are far too
      dangerous to be kept unsheathed'
    name: Thad
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: 'Or what? I''d... take one look and fall for you?

      Keep dreaming,
      man'
    name: Stretch
    character: {fileID: 1319330905}
    pose: SittingDown
    cameraAngle: 2
    face: Blank
  - text: 'Pssht, these eyes are registered lethal weapons and my flamin'' hot bod
      is the sidearm...

      If only... I could see anything.

      We should
      hit the sack, we''d have better luck searching for Jack when it''s light out'
    name: Thad
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: I'm dropping you off at your place, right?
    name: Thad
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'Correction...

      You''re dropping me off at YOUR place.

      I can''t
      let you out of my sight, remember?'
    name: Stretch
    character: {fileID: 1319330905}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: '(M... my place?)

      (A sleepover?)

      (With a g... gir--)'
    name: 
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 7
    face: Blank
  - text: 'Ahem...

      It''s a good thing my parents are out of town. You''re
      on a one way trip to party city, and the night has barely begun'
    name: Thad
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: 'You''re right, we could get away with so much...

      WE COULD TAKE
      A BLOOD OATH!'
    name: Stretch
    character: {fileID: 1319330905}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: (Suddenly, the thought of sleeping over with Stretch scares you a little
      more)
    name: 
    character: {fileID: 1289488429}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
