--- !u!114 &1303904721
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1303904717}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "I printed all the top secret files from the Dojoplex computer before the
      bulldozer came to seal the tunnels shut... I placed an order online for some
      HAZMAT SUITS, too, but I don\u2019t think they\u2019ll be here anytime soon"
    name: Storm
    character: {fileID: 1928772862}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: Great work, Storm.. But... the time for work is over - the S.A.F.E. club
      is back, bigger and better than ever, and it's time to PARTAY
    name: Stretch
    character: {fileID: 1442992734}
    pose: SittingDown
    cameraAngle: 2
    face: Happy
  - text: "Consider all of your party jams \u201Calready pumped\u201D"
    name: Thad
    character: {fileID: 1303904716}
    pose: CasualLean
    cameraAngle: 3
    face: Happy
  - text: (You hand Thad your specially-configured PORTA-COMM and he presses the
      button)
    name: Thad
    character: {fileID: 1303904716}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
