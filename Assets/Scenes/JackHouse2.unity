MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1635160801}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: The tape slots right into the radio - you wonder if Jack used this very
      device to record them - and you press play.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'It''s Spartan Jack''s audio journal!

      He talks about... school sucks...
      besides history class... How the Spartans were like, so metal for making their
      kids fight for food'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: How he would totally share some of his stolen food with Stretch because
      she's basically a Spartan already
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'Ugh. Disgusting.

      You fast forward to the good part...

      A
      scream outside the dojo?'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'A mysterious dungeon, belonging to none other than Stretch herself?

      You
      knew she was shady...'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: And a kid who snuck into the dojo, and said something about a powerful
      sword
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'This must be what Spartan Jack was looking for at the dojo...

      And
      what the girls have been trying to keep from you!'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
