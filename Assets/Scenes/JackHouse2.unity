  blockInteraction: 0
  dialog:
  - text: 'Suddenly, you hear...

      Oh crap,

      Oh crap oh crap oh crap'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: 'Someone''s home!!

      They''re gonna think YOU are the one wrecking
      the place!!'
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Angry
  - text: You're too young to go to jail!!!
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: You better find another way out... Maybe there's a path to the roof
    name: 
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 5
    face: Confused
  turnToFace: 0
