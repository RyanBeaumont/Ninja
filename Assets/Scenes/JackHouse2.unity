--- !u!114 &1795118663
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1795118657}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: 'This looks like an ordinary drawer...

      But suddenly, you see it'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: 'LIMITED EDITION MARVEL COMICS??!?!

      Score!'
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 5
    face: 
  - text: 'You disregard everything else and start piling the comic books into your
      arms...

      And then you notice something hiding beneath'
    name: 
    character: {fileID: 0}
    pose: Meditating
    cameraAngle: 5
    face: 
  - text: A small hole, just big enough for a key
    name: 
    character: {fileID: 0}
    pose: Meditating
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1795118664
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1795118657}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  dialog:
  - text: You pick the lock, and the floor of the drawer comes loose revealing...
      a hidden compartment!
    name: 
    character: {fileID: 0}
    pose: Meditating
    cameraAngle: 5
    face: 
  - text: 'And in this compartment, you find... Ancient technology.

      Strange
      black rectangles. With white circles... Some kind of film? Oh-- oh you know
      this one'
    name: 
    character: {fileID: 0}
    pose: Meditating
    cameraAngle: 5
    face: 
  - text: 'Your teacher once brought one of these relics into class!

      Microcasette
      tapes!'
    name: 
    character: {fileID: 0}
    pose: Meditating
    cameraAngle: 5
    face: 
  - text: 'This must''ve been what the ninjas were looking for...

      You just
