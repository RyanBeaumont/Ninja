    cameraAngle: 4
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &596097415
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 596097411}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "That was so stupid of you last time we met, killing me\u2026 But I realize
      it was only a misunderstanding, just.. sister business."
    name: Jade
    character: {fileID: 243701856}
    pose: 
    cameraAngle: 3
    face: Surprised
  - text: "How could you understand, when I've been hiding the truth of who I am.
      What do I have to lose. I\u2019m a ghost now anyway."
    name: Jade
    character: {fileID: 243701856}
    pose: 
    cameraAngle: 3
    face: Surprised
  - text: "Here\u2019s the story Sensei tells - that I was his star student. Storm\u2019s
      best friend."
    name: Jade
    character: {fileID: 243701856}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: That, when a tragic accident left me orphaned at the age of 10, Storm begged
      and begged to adopt me. This is all true, and I owe my whole life to Storm..
      But no one will tell you the details of this accident.
    name: Jade
    character: {fileID: 243701856}
    pose: Explaining
    cameraAngle: 7
    face: Confused
  - text: That is why I used my spirit powers to construct this trap - this MEMORY
      PALACE. So that, if you choose to stand in my way on the night of the solstice...
      You will at least be doing it with knowledge of the TRUTH
    name: Jade
    character: {fileID: 243701856}
    pose: Explaining
    cameraAngle: 7
    face: Confused
  - text: Let me take you back to that fateful day, years ago...
    name: Jade
    character: {fileID: 243701856}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
