--- !u!114 &596097413
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 596097411}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'JADE?!?!

      H-- How??'
    name: Spartan Jack
    character: {fileID: 153785162}
    pose: 
    cameraAngle: 12
    face: 
  - text: I have E-S-Pow on a level so great that none of you could possibly understand
    name: Jade
    character: {fileID: 243701856}
    pose: Explaining
    cameraAngle: 3
    face: Mad
  - text: How about you understand this SWORD in your FACE
    name: Spartan Jack
    character: {fileID: 153785162}
    pose: Unsheath
    cameraAngle: 6
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &596097414
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
