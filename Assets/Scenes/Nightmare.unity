MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943586110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "(The winter solstice is circled three times in red and the words \u201CFREEDOM
      AT LAST\u201D is scrawled across it)"
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: "The winter solstice is when spirits are at their strongest. The sword
      will have more power - all of them will. And it\u2019s the one chance we have
      to make contact with them"
    name: Stretch
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: I can make contact.. with my dad?
    name: Spartan Jack
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: If he's in that blade you carry around... Maybe. But it's no Khan - that
      power only comes with time
    name: Stretch
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
