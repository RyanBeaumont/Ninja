--- !u!114 &2110639717
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2110639716}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Now that we have the proper ambiance...

      Let''s get down to business'
    name: Torch
    character: {fileID: 2110639715}
    pose: SittingDown
    cameraAngle: 0
    face: Happy
  - text: (You hand him the radio and he begins poking at it)
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 5
    face: Confused
  - text: (He plugs it into the wall... Sparks fly everywhere. Your party backs up
      a bit)
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Blank
  - text: 'Should we...

      Come back later?

      How long does this--'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Blank
  - text: 'AHA!

      Never underestimate the abilities of your favorite mad genius!'
    name: Torch
    character: {fileID: 2110639715}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  - text: Man, Porta-Comms are such a scam... Inside each of these "untraceable"
      units is a MEMORY CARD!
    name: Torch
    character: {fileID: 2110639715}
    pose: Idle
    cameraAngle: 3
    face: Confused
  - text: It's got a limited memory.. but we should be able to hear at least the
      last few conversations... All I gotta do is plug it into this retrofitted radio
      and we can listen in!
    name: Torch
    character: {fileID: 2110639715}
    pose: SittingDown
    cameraAngle: 5
    face: Confused
  - text: (Torch puts the memory card in and you press PLAY)
    name: 
    character: {fileID: 413536891}
    pose: 
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
