  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: (You don't know what compelled you to knock on your friend Torch's door,
      but you hear he's the expert on weapons... And one of the only people you can
      trust)
    name: 
    character: {fileID: 894873099}
    pose: 
    cameraAngle: 5
    face: 
  - text: "The voice inside replies,\nWHO\u2019S THERE"
    name: Torch
    character: {fileID: 8992729449562663849}
    pose: 
    cameraAngle: 5
    face: 
  - text: Just a friendly neighborhood Spartan
    name: Spartan Jack
    character: {fileID: 894873099}
    pose: Embarrassed
    cameraAngle: 5
    face: Happy
  - text: "I don\u2019t want any of your cookies.. Go on, scram"
    name: Torch
    character: {fileID: 8992729449562663849}
    pose: Embarrassed
    cameraAngle: 5
    face: Happy
  - text: I hear you know a thing or two about soulblades?
    name: Spartan Jack
    character: {fileID: 894873099}
    pose: Embarrassed
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
