  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Wha\u2026 Where am I?"
    name: Torch
    character: {fileID: 1912234695}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: "You\u2019re inside my van. That should be obvious to you."
    name: ???
    character: {fileID: 1324291734}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: W... Who?
    name: Torch
    character: {fileID: 1912234695}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: A nobody. A force of nature. An agent of change
    name: ???
    character: {fileID: 1324291734}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: '(You recognize the voice immediately)

      Agent R??! But... How?'
    name: Torch
    character: {fileID: 1912234695}
    pose: SittingDown
    cameraAngle: 4
    face: Mad
  - text: "Save the questions for later. We\u2019ll be at the dojoplex in half an
      hour."
    name: Agent R
    character: {fileID: 1324291734}
    pose: SittingDown
    cameraAngle: 4
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
