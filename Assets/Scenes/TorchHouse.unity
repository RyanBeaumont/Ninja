--- !u!114 &511093150
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 511093141}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "(You begin to feel a powerful force tugging on your thoughts\u2026 Jade
      has awoken. You think she is trying some sort of E-S-Pow on your head.)"
    name: 
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 7
    face: Confused
  - text: "(Oh no\u2026 You don\u2019t know if you can fight her again. You\u2019re
      running too low on drugs\u2026 There is only one way you see out of this\u2026)"
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 7
    face: Confused
  - text: "(You\u2019ve never made a successful teleportation before. Last time you
      tried, you wound up crammed into a train-shaped playground clearly made for
      smaller children\u2026 But now you are confident you can make it\u2026)"
    name: 
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 5
    face: Happy
  - text: "(You summon every single ounce of CHI from the depths of your soul. Suddenly,
      your body begins to\u2026)"
    name: 
    character: {fileID: 0}
    pose: Levitate
    cameraAngle: 5
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
