--- !u!114 &779392772
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 779392761}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Dude... Sick!
    name: Thad
    character: {fileID: 1891132014}
    pose: Defeated
    cameraAngle: 13
    face: Happy
  - text: "Okay. me next. I\u2019m ready (this is stupid)"
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: Center yourself. Think of all your ancestors, the epic warriors who wielded
      your blade. Put yourself in their shoes
    name: Stretch
    character: {fileID: 779392763}
    pose: Sheath
    cameraAngle: 2
    face: Confused
  - text: (you think of your MOM, ugh. Here goes)
    name: Spartan Jack
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 7
    face: Confused
  - text: SOUL RELEASE!
    name: Spartan Jack
    character: {fileID: 0}
    pose: Cut
    cameraAngle: 4
    face: Confused
  - text: Nothing's happening...
    name: Spartan Jack
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 2
    face: Confused
  - text: Name your move!! make something up
    name: Thad
    character: {fileID: 1891132014}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  - text: THAT'S NOT NECESSARY THAD LET HIM FOCUS
    name: Stretch
    character: {fileID: 779392763}
    pose: Explaining
    cameraAngle: 2
    face: Mad
  - text: "(All of a sudden, you feel power welling up through your stomach. Pure
      chi - and a flavor different from the typical kind. It energizes your muscles.
      It strengthens your bones. It flows through your BODY. And suddenly\u2026)\r"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 4
    face: Confused
  - text: "THIS\u2026 IS\u2026 SPARTAAAAA!!!"
    name: Spartan Jack
    character: {fileID: 0}
    pose: CraneKick
    cameraAngle: 14
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
