  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: This is the power of my family weapon! In this state, I can move twice
      as fast as my opponents! I can strike before they even blink!
    name: Stretch
    character: {fileID: 779392763}
    pose: BoTwirl
    cameraAngle: 14
    face: Happy
  - text: 'Yeah right...

      BLOCK THIS!'
    name: Thad
    character: {fileID: 1891132014}
    pose: IdlePunchingBag
    cameraAngle: 6
    face: Mad
  turnToFace: 0
