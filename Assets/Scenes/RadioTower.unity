--- !u!114 &779392776
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 779392761}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "\u2026Duuuude!!!"
    name: Thad
    character: {fileID: 1891132014}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: oh my god my wall
    name: Stretch
    character: {fileID: 779392763}
    pose: Defeated
    cameraAngle: 13
    face: Blank
  - text: W... Wha...
    name: Spartan Jack
    character: {fileID: 0}
    pose: Sheath
    cameraAngle: 2
    face: Blank
  - text: "I\u2019d consider this lesson a moderate success. You\u2019ll learn to
      do it better - let\u2019s just hope you don't wreck too much in the meantime.
      Class dismissed!"
    name: Stretch
    character: {fileID: 779392763}
    pose: HandsOnHips
    cameraAngle: 5
    face: Confused
  - text: Impressive, man! High five!
    name: Thad
    character: {fileID: 1891132014}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: Come back tomorrow and we can spar! (Ehehehe)
    name: Stretch
    character: {fileID: 779392763}
    pose: HandsOnHips
    cameraAngle: 12
    face: Happy
  - text: "All of this just leaves you with more questions\u2026 and a profound sense
      of awesomeness. but you don\u2019t want to make a fool of yourself in front
      of your new friends\u2026)"
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "(You have your suspicions about Stretch anyway, considering she is friends
      with your greatest rival. And Thad, apparently? You think you\u2019d better
      go knock out some QUESTS, namely, sleeping.)\r\n"
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: 'SPECIAL MOVE UNLOCKED: SPARTA! KICK'
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
