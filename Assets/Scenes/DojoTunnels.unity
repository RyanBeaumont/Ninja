--- !u!114 &2047961197
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2047961195}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Jack\u2026 You\u2026"
    name: 'party[1]'
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 0
    face: Confused
  - text: You did the right thing, Spartan.
    name: 'party[2]'
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 0
    face: Confused
  - text: "That was certainly one way to find out the truth\u2026 Good thing we\u2019re
      not all dead from radiation!"
    name: Torch
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "Well it looks like the sword is in your hands\u2026 What do you want to
      do with it?"
    name: 'party[1]'
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "I\u2026 I just wanna\u2026"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  - text: "You can\u2019t bring him back, Jack"
    name: 'party[1]'
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "(Inside your mind, two wolves fight tooth and nail. You hold the sword
      responsible for turning Jade into the monster she became - you\u2019re not
      gonna let it happen to your family too. You don\u2019t know whether it's better
      to destroy it, or protect it. But suddenly\u2026)"
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 7
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
