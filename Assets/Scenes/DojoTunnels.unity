  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Um, Storm\u2026 Somebody\u2019s channeling high level E-S-Pow on us. I
      can feel it."
    name: Stretch
    character: {fileID: 2121539817}
    pose: Embarrassed
    cameraAngle: 5
    face: 
  - text: "She\u2019s here\u2026 Stretch, grab my hand"
    name: Storm
    character: {fileID: 355964733}
    pose: Embarrassed
    cameraAngle: 3
    face: Surprised
  - text: Um, okay. Why?
    name: Stretch
    character: {fileID: 2121539817}
    pose: Idle
    cameraAngle: 3
    face: Confused
  - text: "Focus on Jade. Fill her mind with pointless noise. I\u2019m trying to
      disrupt her tai chi tele\u2013\r\n"
    name: Storm
    character: {fileID: 355964733}
    pose: Idle
    cameraAngle: 3
    face: Confused
  turnToFace: 0
