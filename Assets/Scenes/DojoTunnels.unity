--- !u!114 &2047961214
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2047961195}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c530a24ea0ef8d34990d94afbefe7c3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - "You raise Khan and smash it over your knee, and it shatters in a million pieces
    with the screams of a million freed souls. And suddenly, the room\u2019s glow
    fades."
  - Your mom looks at you in stunned silence, and then runs to wrap her arms around
    you. It might take you a long time to forgive her, but now that the sword is
    gone, you are filled with hope for the future
  - "And in a move that is oh-so-typical of your mother, she waves around her hands,
    pulls a smoke bomb from her pocket, and disappears. You\u2019ll have to catch
    up back at home"
