--- !u!114 &1504056329
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1504056314}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "SPARTAN\u2026. BLOCK!!!!"
    name: Spartan Jack
    character: {fileID: 861414373}
    pose: BlockSuccess
    cameraAngle: 6
    face: Mad
  - text: 'Spartan Jack? Thad? Big Sam?

      You TRAITORS! You were gonna leave
      us here to die and then steal the sword!'
    name: Storm
    character: {fileID: 355964733}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Mad
  - text: You.. Saved me?
    name: Stretch
    character: {fileID: 2121539817}
    pose: Embarrassed
    cameraAngle: 3
    face: Confused
  - text: Oh what an interesting turn of events! ALL of my loose ends are in the
      same room
    name: Possessed Torch
    character: {fileID: 107997922}
    pose: BlockSuccess
    cameraAngle: 6
    face: Mad
  - text: "And we\u2019re all out of bubblegum"
    name: Spartan Jack
    character: {fileID: 861414373}
    pose: ArmsCrossed
    cameraAngle: 6
    face: Mad
  - text: Ugh. Y'know what, Jade? You can have the code. If this is how my friends
      are gonna treat me, who needs enemies. I'm done with you all... Storm, OUT!
    name: Storm
    character: {fileID: 355964733}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: (Storm disappears in a puff of smoke, but Stretch stays, taking a deep
      breath)
    name: Stretch
    character: {fileID: 2121539817}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: 'Thank you, Jack...

      You guys might be stupid, but you''ve got heart'
    name: Storm
    character: {fileID: 2121539817}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: 'DO YOU KNOW WHAT YOU DON''T HAVE? SPINE!!

      I thought you were an
      honorable Spartan but it turns out you''re just as slimy and backstabbing as
      these dojo girls!'
    name: Thad
    character: {fileID: 594412980}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Mad
  - text: 'The man, the myth, the Thad... Is OUT too.

      This plan was a death
      trap anyway'
    name: Thad
    character: {fileID: 594412980}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: '(Stretch has joined your party)

      (Thad has left your party)'
    name: Storm
    character: {fileID: 2121539817}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
