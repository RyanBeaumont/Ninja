  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: JADE, I'M GONNA KILL YOU!!!
    name: Stretch
    character: {fileID: 2121539817}
    pose: Unsheath
    cameraAngle: 7
    face: Mad
  - text: (Torch winds up his blade, and it glows a deadly blue)
    name: 
    character: {fileID: 861414373}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Mad
  - text: Look away, Spartan...
    name: Thad
    character: {fileID: 594412980}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "(Every fiber of your being wants to jump out and save her\u2026 But would
      you be throwing away the only chance you had at seeing the spirit world, or
      destroying the weapon for good?)"
    name: 
    character: {fileID: 861414373}
    pose: Embarrassed
