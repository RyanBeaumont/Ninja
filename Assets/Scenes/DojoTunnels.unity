  failBranch: 
  dialog:
  - text: "You know there\u2019s only one escape from down there! You\u2019re gonna
      have to come out and fight through us\u2026"
    name: Stretch
    character: {fileID: 472883133}
    pose: Sassy
    cameraAngle: 2
    face: Mad
  - text: This tunnel system goes forever, there's got to be another way out of here
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
