    face: Mad
  - text: (In a moment of pure agony, Stretch suddenly lifts off the floor. Overflowing
      with CHI, she closes her eyes, and vanishes, along with the body of her best
      friend)
    name: Stretch
    character: {fileID: 2121539817}
    pose: Levitate
    cameraAngle: 3
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
