--- !u!114 &253396946
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 253396941}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Unnngghhh\u2026 Hrrr\u2026."
    name: Torch
    character: {fileID: 1745887112}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: "What\u2026 just happened? Where am I\u2026 Why does everything hurt\u2026"
    name: Torch
    character: {fileID: 1745887112}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: "Storm?! Jade?! Could somebody please tell me what in the world is going
      on?! Last thing I knew, I was being drugged out in the back of a van, all thanks
      to\u2026\r\n"
    name: Torch
    character: {fileID: 1745887112}
    pose: Meditating
    cameraAngle: 13
    face: Confused
  - text: 'OH GOD THERE SHE IS!!

      WHEN WILL THIS NIGHTMARE END?!?'
    name: Torch
    character: {fileID: 1745887112}
    pose: Embarrassed
    cameraAngle: 6
    face: Mad
  - text: "Ah! It feels good to be alive again\u2026 and not just alive, alive with
      the power that was supposed to be mine all along! I feel it coursing through
      my veins!"
    name: Jade
    character: {fileID: 582607659}
    pose: Explaining
    cameraAngle: 5
    face: Mad
  - text: (Jade begins to drink copious amounts of Coca-Cola, the last of her massive
      stash. Torch tries to stand up, stumbles to his feet, and joins your party)
    name: 
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 5
    face: Mad
  - text: (It's time you recover your party, choose your deck, and end this once
      and for all)
    name: 
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 5
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
