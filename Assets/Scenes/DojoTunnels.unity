--- !u!114 &1504056319
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1504056314}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Yess! She landed outside the vault! With\u2026"
    name: Stretch
    character: {fileID: 2121539817}
    pose: Explaining
    cameraAngle: 5
    face: Happy
  - text: Torch?!?!
    name: Storm
    character: {fileID: 355964733}
    pose: Explaining
    cameraAngle: 6
    face: Happy
  - text: Storm, give me the combination
    name: Torch?
    character: {fileID: 107997922}
    pose: Possessed
    cameraAngle: 3
    face: Angry
  - text: "Something\u2019s gotten into him!"
    name: Stretch
    character: {fileID: 2121539817}
    pose: Embarrassed
    cameraAngle: 2
    face: Angry
  - text: Give Jade the combination, or I will have no choice but to use my Sword
      of Deadly Shenanigans on you
    name: Torch?
    character: {fileID: 107997922}
    pose: Unsheath
    cameraAngle: 7
    face: Angry
  - text: "TORCH?!?! NO.. NOT YOU\u2026"
    name: Storm
    character: {fileID: 355964733}
    pose: HandsOnHips
    cameraAngle: 7
    face: Mad
  - text: "Don\u2019t do it \u2013 the vault is filled with radiation!"
    name: Stretch
    character: {fileID: 2121539817}
    pose: HandsOnHips
    cameraAngle: 2
    face: Mad
  - text: Maybe so. But that won't affect a spirit, will it?
    name: Torch?
    character: {fileID: 107997922}
    pose: Possessed
    cameraAngle: 2
    face: Mad
  - text: "You\u2019re going to kill everyone for this?!?!"
    name: Storm
    character: {fileID: 355964733}
    pose: HandsOnHips
    cameraAngle: 2
    face: Mad
  - text: "I have to admit, I am kind of proud of myself. It was the perfect plan.
      All I needed was to get all the Insiders gathered in the same room\u2026 On
      the solstice, when my spirit is closest to the real world!"
    name: Torch?
    character: {fileID: 107997922}
    pose: Possessed
    cameraAngle: 2
    face: Mad
  - text: (Jade begins clicking the numbers in place, her spirit form beginning to
      affect reality)
    name: 
    character: {fileID: 2121539817}
    pose: Embarrassed
    cameraAngle: 5
    face: Mad
  - text: "Don\u2019t think of the combination! She\u2019s invading your thoughts!
      And she\u2019s probably already in Torch\u2019s head too \u2013 We need to
      take them both out before she finds a way in..."
    name: Stretch
    character: {fileID: 2121539817}
    pose: Embarrassed
    cameraAngle: 2
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
