--- !u!114 &1181644952
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1181644939}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Stop fighting, everyone! Storm was telling the truth! Jade is coming to
      open the vault, steal the sword for herself, kill us all! If we keep fighting
      each other like we are now, we\u2019ll be too weak to stop her!"
    name: Stretch
    character: {fileID: 1524020893}
    pose: Sass
    cameraAngle: 2
    face: Mad
  - text: "You\u2019re lying. Both of you. You just don\u2019t want us getting in
      on your little secrets. *Cough Cough* What\u2019s that? My ALLERGIES. To your
      BULL CRAP."
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 2
    face: Angry
  - text: Big Sam, are you prepared?
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: I have never been more prepared in my life
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
