  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "*groan* But seriously, where\u2019s my mace?\r\n"
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Disappointed
  - text: "Maybe it fell down the stairs\u2026"
    name: Thad
    character: {fileID: 578499684}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: "Oh, yeah. Maybe. I\u2019ll go and check."
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: "No, no! Wait! Maybe I should be the one to\u2026 check\u2026 down the
      stairs and all\u2026"
    name: Thad
    character: {fileID: 578499684}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "Alright, well whatever. Don\u2019t take too long."
    name: Storm
    character: {fileID: 1798691671}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: (Phew. Close one)
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
