  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "(You have absolute control. Catlike finesse. Laser precision. You have
      never felt more athletic in your life, and you yell like a maniac while pirouetting
      straight over your mother\u2019s head)"
    name: SpartanJack
    character: {fileID: 0}
    pose: BoTwirl
    cameraAngle: 3
    face: Mad
  - text: "What have I created\u2026"
    name: Mom
    character: {fileID: 1143503025}
    pose: Embarrassed
    cameraAngle: 6
    face: Surprised
  - text: "THIS!!! \nIS!!! \nSPARTA!!!!!"
    name: SpartanJack
    character: {fileID: 0}
    pose: CraneKick
    cameraAngle: 6
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
