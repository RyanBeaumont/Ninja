  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Whoa... A secret training center?
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "You hear a conversation from above\u2026"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: "\"Thad's bladder must\u2019ve been BURSTING\u2026 He\u2019s been gone
      a long time\"\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: I gotta get back up there. You go on alone, Jack.
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1943447040
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943447030}
