--- !u!114 &1468522255
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468522253}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: What just happened down there?
    name: Storm
    character: {fileID: 1364881548}
    pose: HandsOnHips
    cameraAngle: 2
    face: Surprised
  - text: "I don\u2019t know\u2026 But the building is shaking! This can\u2019t be
      good!"
    name: Stretch
    character: {fileID: 472883133}
    pose: Embarrassed
    cameraAngle: 2
    face: Mad
  - text: We need to go down there! Something must be wrong!
    name: Storm
    character: {fileID: 1364881548}
    pose: Explaining
    cameraAngle: 2
    face: Surprised
  - text: "I think that\u2019s a VERY BAD IDEA, STORM. Anyone else would\u2019ve
      thought to run AWAY from the collapsing homemade bunker"
    name: Stretch
    character: {fileID: 472883133}
    pose: Sassy
    cameraAngle: 2
    face: Mad
  - text: "But Thad and Spartan Jack are down there! They're our allies... We don\u2019t
      want another death on our hands!"
    name: Storm
    character: {fileID: 1364881548}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: Well, at least wait until everything settles! Jeez, crazy person!
    name: Stretch
    character: {fileID: 472883133}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
