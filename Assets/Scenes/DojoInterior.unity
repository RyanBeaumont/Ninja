--- !u!114 &909569739
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 909569736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "You find an iron mace hastily knit to a hair tie. Affixing it to your
      head, you wonder who in their right mind would make such a thing\u2026"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: "You have the feeling you look INCREDIBLY DORKY right now. But heck, it\u2019s
      midnight. And you\u2019re in a tunnel. Who could POSSIBLY see you?"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: "Jeez this thing is topheavy. Somone must have neck muscles of STEEL\u2026\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
