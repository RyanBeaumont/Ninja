  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Um, Torch...

      Do you wanna... maybe...

      Be in my squad?'
    name: Storm
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Surprised
  - text: 'I don''t know, Storm.

      What''s the magic word?'
    name: Torch
    character: {fileID: 1230696548}
    pose: SittingDown
    cameraAngle: 13
    face: Happy
  - text: Free coke?
    name: Storm
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: You know me so well
    name: Torch
    character: {fileID: 1230696548}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
