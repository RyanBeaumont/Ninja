--- !u!114 &1112263082
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1112263080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You... Jutsu?
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  - text: Another one of Sensei's nonsensical--
    name: Torch
    character: {fileID: 1112263079}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: Ahem
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Angry
  - text: (ahem) genius trains of thought. You'll be kicking butt in no time.
    name: Torch
    character: {fileID: 1112263079}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: I'll make you... My apprentice
    name: Torch
    character: {fileID: 1112263079}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: My star student. My minion. My first disciple in the church of Torch (That's
      my name, don't you forget)
    name: Torch
    character: {fileID: 1112263079}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: And your first lesson is, be cool. Don't give a crap about anything.
    name: Torch
    character: {fileID: 1112263079}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: Oh, I'm the coolest. Natually.
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: Pssht. Whatever
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 0
