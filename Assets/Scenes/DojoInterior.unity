  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You're about to exit the dojo when your iPhone rings!
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'It''s a message from your PORTA-COMM!

      You better get home and see
      who it is'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &955928500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 955928496}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Aha! You''re back!

      A dedicated one, I see!'
    name: Sensei
    character: {fileID: 955928495}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: 'It''s time for my favorite lesson!

      Sit down, let me show you the
      world of SPECIALTY DRINKS!'
    name: Sensei
    character: {fileID: 955928495}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: 'First up - coffee!

      It gives you... energy!

      And it''s so
      ''MURICAN you get some MP too!'
    name: Sensei
    character: {fileID: 955928495}
    pose: Drink
    cameraAngle: 0
    face: Happy
  - text: 'I''m feeling young n'' fresh already!

      Second drink - Sierra Mist!
      Perfect for escaping a tight bind. Most people don''t know this, but you can
      throw it on the ground and escape random encounters in a cloud of mist'
    name: Sensei
    character: {fileID: 955928495}
    pose: Drink
    cameraAngle: 0
    face: Happy
  - text: 'You could, y''know, run away too...

      But us ninjas love to be DRAMATIC.'
    name: Sensei
    character: {fileID: 955928495}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: 'Now do you know about the rarest and most important soda?

      DR. PEPPER!

      Tastes
      so good the dead come back to life!'
    name: Sensei
    character: {fileID: 955928495}
    pose: Drink
    cameraAngle: 0
    face: Happy
  - text: 'The DR has done it again!

      Alright your turn - give em all a sip!'
    name: Sensei
    character: {fileID: 955928495}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: 'Er...

      I seem to have drank ''em all.

      Oh well, my daughter
      STORM has plenty more in her dojo shop!'
    name: Sensei
    character: {fileID: 955928495}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  - text: And one more thing... In addition to drinks, you can also hold EQUIPMENT
      in your inventory!
    name: Sensei
    character: {fileID: 955928495}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: At anytime, you can press [ESCAPE] and click on a character to see their
      menu. There, you can edit your deck and click on EQUIPMENT to equip them
    name: Sensei
    character: {fileID: 955928495}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: 'Try it with this BIKE HELMET!

      The ultimate in protective equipment.

'
    name: Sensei
    character: {fileID: 955928495}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 1
