--- !u!114 &2125450524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2125450521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Your name is BIG SAM. Ever since birth, you have been one thousand percent
      beef. '
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: You have other attributes too, mad ninja skills and a big heart to name
      two, but they seem to have been irrelevant when it came to naming you.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: "You have used those mad ninja skills to steal a few things on your past
      adventures\u2026 A geiger counter from Torch, a can of weapons-grade body spray
      from Thad, a few lockpicks dropped by unfortunate ninjas"
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: "You giggle and trip on your own feet and bump into people so often that
      no one notices, and sometimes you end up with a little something extra in your
      pocket. Everyone says they\u2019re gonna get to the truth, but they\u2019re
      all too jaded to listen"
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
