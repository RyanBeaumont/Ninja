MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2037307390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Don\u2019t come back here! You need to be SAFE to join our secret club!\r\n"
    name: Torch
    character: {fileID: 1455778815}
    pose: ArmsCrossed
    cameraAngle: 0
    face: 
  - text: SAFE?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Idle
    cameraAngle: 0
    face: Happy
  - text: "Secret Assassins Feared by Everyone. It\u2019s our little club. Our SECRET
      club. You didn\u2019t hear a thing.\r\n"
    name: Torch
    character: {fileID: 1455778815}
    pose: Explaining
    cameraAngle: 0
    face: 
  - text: And what if I want to join?
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  - text: "Well first off, you gotta be so UNSHAKEABLE that you don\u2019t even FLINCH
      when I show you these ROCK SOLID ABS. BOOM! Look at these, baby!"
    name: Torch
    character: {fileID: 1455778815}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: (Wow! You can almost see the definition!)
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Happy
  turnToFace: 1
  snapPlayerPosition: 1
