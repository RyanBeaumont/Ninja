    name: Spartan Jack
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: The rocks might not have settled yet. We better be careful.
    name: Spartan Jack
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
