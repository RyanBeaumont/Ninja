--- !u!114 &1943447037
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943447030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Oh, THERE you are, Thad! I thought I\u2019d lost you for a minute there."
    name: Storm
    character: {fileID: 1798691671}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: You know what else I seemed to have lost? My MACE...
    name: Storm
    character: {fileID: 1798691671}
    pose: Sassy
    cameraAngle: 0
    face: Confused
  - text: 'Mace? What mace?

'
    name: Thad
    character: {fileID: 578499684}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: Thad, did you steal my mace?
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Surprised
  - text: "Mace? I didn\u2019t steal a.. What mace?\r\n"
    name: Thad
    character: {fileID: 578499684}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "My HAIR MACE! Well, I know you stole SOMETHING\u2026 You\u2019re making
      that face again.\r\n"
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
