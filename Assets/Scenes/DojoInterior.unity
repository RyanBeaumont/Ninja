  dialog:
  - text: 'Dang it, another vault door...

      This one looks even higher security'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: SPARTAN JACK searches his pocket for lock picks, and then starts swinging
      at the door with his sword
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: "Jack, don\u2019t you think you\u2019re being a little loud with all that
      bashing you\u2019re doing? You\u2019re gonna attract the attention of the\u2026\r\n"
    name: Thad
    character: {fileID: 0}
