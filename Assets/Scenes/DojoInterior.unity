--- !u!114 &2121287622
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2121287616}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: I jumped like fifty feet in the air, flipping every which way, sword above
      my head, and then, WHACK!
    name: Spartan Jack
    character: {fileID: 343813143}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: "So, yeah, that\u2019s how it happened. Crazy, right?"
    name: Spartan Jack
    character: {fileID: 343813143}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: "I.. don\u2019t know how to feel about it. I went back home and realized\u2026
      There\u2019s no one else there"
    name: Spartan Jack
    character: {fileID: 343813143}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "You did the right thing\u2026 You do realize she was absolutely psychotic,
      right? And until you figure your life out, there\u2019s always room to sleep
      in the TorchCave(\u2122)"
    name: Torch
    character: {fileID: 1723888408}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "Don\u2019t think too much, Spartan. If anyone was meant to lead the S.A.F.E.
      Club, it\u2019s you. What do you think, Storm?"
    name: Stretch
    character: {fileID: 1801288290}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: Please! Running a club is hard enough work WITHOUT us all trying to kill
      each other. Finally, I can get some REST!
    name: Storm
    character: {fileID: 587505749}
    pose: SittingDown
    cameraAngle: 4
    face: Happy
  - text: What now, soldier?
    name: Big Sam
    character: {fileID: 2000921898}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: "We lock away the sword. We bury it, along with the vault and the decaying
      tunnels. And then\u2026 I\u2026 I don\u2019t know."
    name: Spartan Jack
    character: {fileID: 343813143}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: "May I suggest\u2026 a PARTY?"
    name: Thad
    character: {fileID: 318650398}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
