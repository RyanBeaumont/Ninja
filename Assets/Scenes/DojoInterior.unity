  blockInteraction: 0
  failBranch: 
  dialog:
  - text: You look at the first book. It is a self-help book, but the pages are cut
      out to make room for a bottle of emergency COCA-COLA. Dang it, how are you
      supposed to unlock the three secrets to a better you?
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: The second book is labeled "Cracking the Code" and there is a note inside.
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  - text: '"6942"

      Short for SIXTYNINE 420 but I ran out of room

      Hehehe

      -Jade'
    name: 
    character: {fileID: 0}
    pose: 
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
