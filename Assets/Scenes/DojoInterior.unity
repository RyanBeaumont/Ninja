  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Hiya! Ever wanna learn tai-chi?
    name: Stretch
    character: {fileID: 575606095}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: Tai chi? Isn't that where you wave your hands around and find inner peace
      or whatever?
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: Wouldn't you like to know? I'm teaching a SECRET CLASS tonight - meet me
      on the forest path
    name: Stretch
    character: {fileID: 575606095}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: Something is fishy here... STRETCH is like, the master's star student.
      And totally lethal. Why would she be doing tai chi?
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 0
