--- !u!114 &1468522260
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468522253}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "The walls around here sound kind of hollow\u2026 That can\u2019t be safe,
      can it?"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Happy
  - text: "(You knock on the walls. You don\u2019t know what that could possibly
      accomplish, but it definitely sounds hollow)"
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: "(That can\u2019t be a good thing for the bunker\u2019s strength. It frightens
      you to think that Stretch and Storm could\u2019ve built this themselves\u2026
      They don\u2019t exactly seem to be experts in\u2026)"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: (Suddenly, the room starts shaking)
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 5
    face: Surprised
  - text: "Uh, Thad? Maybe you shouldn\u2019t have.. knocked\u2026 on the wall?"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Surprised
  - text: The tunnels are collapsing! Quick, RUN!
    name: Thad
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 7
    face: Mad
  - text: "Into the ninjas? No\u2026 I think we have a better option\u2026"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
