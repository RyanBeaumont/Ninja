--- !u!114 &1943447039
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943447030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Whoa... A secret training center?
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "You hear a conversation from above\u2026"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: "\"Thad's bladder must\u2019ve been BURSTING\u2026 He\u2019s been gone
      a long time\"\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: I gotta get back up there. You go on alone, Jack.
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1943447040
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943447030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "*groan* But seriously, where\u2019s my mace?\r\n"
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Disappointed
  - text: "Maybe it fell down the stairs\u2026"
    name: Thad
    character: {fileID: 578499684}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: "Oh, yeah. Maybe. I\u2019ll go and check."
    name: Storm
    character: {fileID: 1798691671}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: "No, no! Wait! Maybe I should be the one to\u2026 check\u2026 down the
      stairs and all\u2026"
    name: Thad
    character: {fileID: 578499684}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: "Alright, well whatever. Don\u2019t take too long."
    name: Storm
    character: {fileID: 1798691671}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: (Phew. Close one)
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
