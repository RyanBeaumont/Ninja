--- !u!114 &625238905
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 625238900}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Wow, you're really taking this seriously
    name: Storm
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'I''m in my training arc.

      Picture the music. The crowds. The bell
      rings...'
    name: Thad
    character: {fileID: 625238899}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: While you were deciding what to do, I was busy learning THIS!
    name: Thad
    character: {fileID: 625238899}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: ...
    name: Thad
    character: {fileID: 625238899}
    pose: FrontFlip
    cameraAngle: 3
    face: Happy
  - text: 'That''s...

      Actually pretty impressive?!'
    name: Storm
    character: {fileID: 0}
    pose: Sassy
    cameraAngle: 12
    face: Confused
  - text: You ain't seen nothing yet
    name: Thad
    character: {fileID: 625238899}
    pose: ArmsCrossed
    cameraAngle: 12
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
