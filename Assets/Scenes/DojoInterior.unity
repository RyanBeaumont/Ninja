--- !u!114 &2072161206
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2072161205}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Riddle me this, Spartan...

'
    name: Big Sam
    character: {fileID: 2072161204}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: Jade is out to kill us all, Chrome Dome is raising an army of white belts
      to steal the sword and end the world, the SAFE club is trying to keep it locked
      up...
    name: Big Sam
    character: {fileID: 2072161204}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: '...But where does Nova fit in? What does she want? '
    name: Big Sam
    character: {fileID: 2072161204}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: 'She''s like... A ninja, I guess?

      At least... I''m assuming?'
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'Not a very good one, since we keep finding her...

      In places she
      probably shouldn''t be. '
    name: Big Sam
    character: {fileID: 2072161204}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: 'Keep your nose out, Spartan.

      Something smells a little... supernatural,
      here'
    name: Big Sam
    character: {fileID: 2072161204}
    pose: SittingDown
    cameraAngle: 0
    face: Confused
  - text: Oh, that's probably Thad. I think he overcooked his lunch again.
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 0
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
