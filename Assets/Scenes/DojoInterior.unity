  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Hey old friend (this is so stupid)

'
    name: Storm
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: "BOB doesn\u2019t respond"
    name: BOB
    character: {fileID: 1494271736967834262}
    pose: 
    cameraAngle: 0
    face: 
  - text: "You\u2019re right. I need to take a step back. I got too caught up in
      my own anger (why am I talking to a dummy?)\r\n"
    name: Storm
    character: {fileID: 0}
    pose: Sassy
    cameraAngle: 0
    face: Confused
  - text: Do you have any wisdom for me?
    name: Storm
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: 
  - text: "BOB doesn\u2019t respond"
    name: BOB
    character: {fileID: 1494271736967834262}
    pose: 
    cameraAngle: 2
    face: 
  - text: Stupid smug little dummy I will END YOU!!!
    name: Storm
    character: {fileID: 0}
    pose: 
    cameraAngle: 2
    face: Mad
  - text: 'You beat on the dummy, demanding guidance. It falls over in one hit, and
      you give up.

'
    name: Storm
    character: {fileID: 0}
    pose: IdlePunchingBag
    cameraAngle: 2
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
