  failBranch: 
  dialog:
  - text: What is THAT?!?!
    name: Thad
    character: {fileID: 0}
    pose: 
    cameraAngle: 0
    face: 
  - text: "It\u2019s... a new tunnel?! I think the collapse just gave us our way
