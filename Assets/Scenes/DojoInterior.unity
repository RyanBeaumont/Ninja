    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: "\u201CI thought you hid it\u201D "
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  - text: "\u201CNo! I left it where it was.. Chrome Dome was right\u201D\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: 
  turnToFace: 0
  snapPlayerPosition: 0
