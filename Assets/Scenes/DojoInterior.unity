--- !u!114 &1324303867
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1324303863}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "*unnnggghhh* *owwwww* That\u2019s enough already. Let\u2019s take a break."
    name: Big Sam
    character: {fileID: 642400227}
    pose: Defeated
    cameraAngle: 4
    face: Confused
  - text: '*uuuuuuunnnggghhh* Sounds good to me.'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 3
    face: Happy
  - text: " Well done, students! As I always say, any no-death day is a good day!
      And for all your hard work\u2026 Cokes all around!\r\n"
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: You knew there was a reason you came.
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: "Just then, Sensei whispers loudly in your direction...\nPSST. \nSPARTAN
      JACK"
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: 'You''re almost ready for a SECRET PRIVATE LESSON

      Reach LEVEL 4
      and we''ll have a talk...'
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  - text: How do I...
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: 'There are always tasks that need completing around here! I''m sure your
      fellow students could use a hand...

      Especially the ones with a yellow
      EXCLAMATION MARK above their head'
    name: Sensei
    character: {fileID: 1980157446}
    pose: Explaining
    cameraAngle: 2
    face: Happy
  - text: ...Or maybe I'm just seeing things in my old age
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'Oh.. and one more thing.

      While you were in class, your MOM called.
      She wants you back home - it sounded urgent'
    name: Sensei
    character: {fileID: 1980157446}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: (Dear lord... You can't go more than five minutes away without your mother
      up in arms)
    name: 
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1324303868
