  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: So... What was in that mysterious alley? Did you pick the lock on that
      door?
    name: Big Sam
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 3
    face: Confused
  - text: 'Ah...

      I haven''t gotten around to it yet'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 4
    face: Confused
  - text: "What are you, CHICKEN?\nBucCAW! \nBok Bok Bok!"
    name: Big Sam
    character: {fileID: 969680079}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: AM NOT!
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Angry
  - text: BET???
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &969680084
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 969680080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: So... What was in that mysterious alley?
    name: Big Sam
    character: {fileID: 969680079}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Confused
  - text: (You look around, realizing the prime suspect is standing in this very
      room)
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  - text: 'I''ll.. Tell ya later...

      In private'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Confused
  - text: 'How about you come over to my house!

      It''s directly across the
      street from this dojo...'
    name: Big Sam
    character: {fileID: 969680079}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: 'Well.. I have a lot to do. YOU-JUTSU, for one, levelling up... And I gotta
      talk to my MOM, ugh.

      How about tomorrow?'
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 4
    face: Confused
  - text: Tomorrow it is. I smell a conspiracy here, and we're gonna get to the bottom
      of it
    name: Big Sam
    character: {fileID: 969680079}
    pose: ArmsCrossed
    cameraAngle: 7
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
