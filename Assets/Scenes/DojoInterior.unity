--- !u!114 &1888042658
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1888042656}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: This must be the vault where they keep the sword
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Happy
  - text: We better find a way in before--
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: (You hear a voice yelling from upstairs)
    name: Thad
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  - text: 'WAIT A SECOND!! THAD, HOW DO YOU KNOW ABOUT THE SECRET TUNNELS?! THAD?!?!
      ARE YOU DOWN THERE?!

'
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "I\u2019M COMING DOWN THERE WITH YOU, THAD. JUST SO YOU DON\u2019T STEAL
      ANYTHING IMPORTANT LIKE THE SPARTAN SWORD OR WHATEVER.\r\n"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Confused
  - text: "Well\u2026 Crap. Who knew such stupid things could blow your cover."
    name: Thad
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  - text: You try to open the door to the vault. Spartan Jack tries jamming paper
      clips through the slot, which strikes you as an incredibly dumb thing to do.
    name: 
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 5
    face: Confused
  - text: " I have the feeling we\u2019re going to need a LOT of lock picks for this
      one\u2026\n"
    name: Spartan Jack
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
