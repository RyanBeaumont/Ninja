  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: I still have my suspicions about you, Jack...
    name: Storm
    character: {fileID: 2054896509}
    pose: Meditating
    cameraAngle: 0
    face: Surprised
  - text: We may not be at each other's throats, but I swear, if you take one step
      toward that vault
    name: Storm
    character: {fileID: 2054896509}
    pose: Meditating
    cameraAngle: 0
    face: Surprised
  - text: 'What is your problem, Storm?

      Can''t you see we have bigger fish
      to fry?

      Are we gonna put this little fight aside and work together or
      not?'
    name: Spartan Jack
