--- !u!114 &2081997181
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2081997180}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: It's the Spartan himself! And I see you are a fellow beverage afficionado
      like me
    name: Thad
    character: {fileID: 2081997179}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: All that Coke is a good start to your collection - but if you wanna be
      cool like me, you gotta drink the good crap
    name: Thad
    character: {fileID: 2081997179}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: It better not be Bang, that sludge is disgusting
    name: Torch
    character: {fileID: 339759884}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: ...and THAT'S the appeal! Our rival dojo drinks 'em by the case, and I
      can always score some by walking around in the TALL GRASS til they come out
      of the woodwork, and then showing them the ol' knuckle sandwich.
    name: Thad
    character: {fileID: 2081997179}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: Y'know what - you give me a BANG --
    name: Thad
    character: {fileID: 2081997179}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: erm.. the energy drink, of course. You give me some of that liquid death
      in a can, I'll show you my SWEET RIDE
    name: Thad
    character: {fileID: 2081997179}
    pose: Embarrassed
    cameraAngle: 0
    face: Confused
  turnToFace: 1
  snapPlayerPosition: 0
