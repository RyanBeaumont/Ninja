--- !u!114 &1049823881
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1049823880}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: ...And that's how I decided to start a NEW system of martial arts, dedicated
      to all of YOU!
    name: Sensei
    character: {fileID: 13634528}
    pose: ArmsCrossed
    cameraAngle: 3
    face: 
  - text: "I call it\u2026 YOU JUTSU! Where I.. put the Jiu Jitsu\u2026 IN YOU!!!
      Eh? See what I did there?"
    name: Sensei
    character: {fileID: 13634528}
    pose: Explaining
    cameraAngle: 5
    face: Happy
  - text: "You like it don\u2019t you? No? I thought it was pretty clever. You\u2019re
      a white belt anyway. Why should a mighty man like me even listen to white belts?"
    name: Sensei
    character: {fileID: 13634528}
    pose: Explaining
    cameraAngle: 3
    face: Happy
  - text: "Anyway, class dismissed! See y\u2019all tomorrow. DON\u2019T BE LATE!\r\n"
    name: Sensei
    character: {fileID: 13634528}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Happy
  - text: You know you should probably be getting home. You make it your QUEST, just
      'cause
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 1
