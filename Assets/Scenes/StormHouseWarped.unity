--- !u!114 &1304502204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1304502196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Hullooo
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: (Enter your right-hand man, the Watson to your Sherlock. The muscle to
      your brain)
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Happy
  - text: "(His name was Big Sam, he had an interest in the armaments of ancient
      warfare, and that\u2019s all it took to become your friend. He was a year younger
      than you, and he\u2019d be your little minion if he wasn\u2019t so darn big)"
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 5
    face: Happy
  - text: "NO ONE messes with my lil\u2019 man"
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: I was just walking him home. He was showing me how much dirt he can fit
      in his mouth
    name: Storm
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 2
    face: Confused
  - text: "Leave or I\u2019ll have no choice."
    name: Big Sam
    character: {fileID: 0}
    pose: Unsheath
    cameraAngle: 7
    face: Mad
  - text: Make me
    name: Storm
    character: {fileID: 0}
    pose: FightingIdle
    cameraAngle: 7
    face: Mad
  turnToFace: 0
  snapPlayerPosition: 0
