--- !u!114 &1304502198
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1304502196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: 'Man.. she''s strong.

      But you put up quite the fight.'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Defeated
    cameraAngle: 13
    face: Confused
  - text: I... Lost...
    name: Big Sam
    character: {fileID: 0}
    pose: Sheath
    cameraAngle: 0
    face: Confused
  - text: 'You saved me, bro.

      No, seriously. Where''d you learn to swing a
      sword like that?...'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 2
    face: Happy
  - text: "And... what\u2019s with the outfit?"
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 5
    face: Confused
  - text: "Are you JEALOUS? I\u2019m a karate man now. I joined a dojo, and they\u2019re
      legit. Serious ninja business.\r\n"
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: 'Like?

'
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 4
    face: Confused
  - text: " If I told you, you\u2019d have to count your last breaths lil man\r\n"
    name: Big Sam
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 0
    face: Confused
  - text: "\u2026you should join. Hang out, kick butt"
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Happy
  - text: "You might need it, what with your\u2026 short puny diminutive stature.
      Not everyone is endowed with the gift of MASS like me"
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: 'Bro...

      You lost'
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 4
    face: Confused
  - text: 'I''ve got the brawn, all I need are the skills

      Are you ready to
      learn the way of the iron fist, my dude?'
    name: Big Sam
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 3
    face: Confused
  - text: "(And before you knew it, you were in your first class of\u2026)"
    name: 
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 5
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
