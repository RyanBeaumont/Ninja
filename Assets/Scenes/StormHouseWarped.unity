--- !u!114 &1304502209
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1304502196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: "Oh it\u2019s the new kid\u2026 coming home from school all alone?"
    name: Storm
    character: {fileID: 0}
    pose: Sassy
    cameraAngle: 0
    face: Happy
  - text: Actually I'm on my way back from yo momma's house
    name: Spartan Jack
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'Heh.. Heh heh.

      Want some company?

      The name''s Storm, by
      the way'
    name: Storm
    character: {fileID: 0}
    pose: Explaining
    cameraAngle: 0
    face: Happy
  - text: 'S... Sure?

      I''m Jack. Spartan Jack.'
    name: Spartan Jack
    character: {fileID: 0}
    pose: Embarrassed
    cameraAngle: 0
    face: Happy
  - text: 'So I''ve heard.

      You think you''re real tough, huh?'
    name: Storm
    character: {fileID: 0}
    pose: HandsOnHips
    cameraAngle: 0
    face: Confused
  - text: 'Yes ma''am.

      The genuine article.'
    name: Spartan Jack
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 0
    face: Happy
  - text: We'll see about that
    name: Storm
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1304502210
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1304502196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Your mom, being a mom to a teenager, was of course wrong about everything
      always - but she was right about one thing. It's winter break already and you've
      only found one friend
    name: 
    character: {fileID: 0}
    pose: ArmsCrossed
    cameraAngle: 2
    face: Happy
  turnToFace: 0
  snapPlayerPosition: 0
--- !u!114 &1304502211
