--- !u!114 &1304502214
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1304502196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14ce5c596a29e284c91b0e2209200b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  encounterID: 
  active: 1
  blockInteraction: 0
  failBranch: 
  dialog:
  - text: Look, we're almost here! Our new home
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 0
    face: Happy
  - text: Ugh... Why do we have to move
    name: Spartan Jack
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 2
    face: Confused
  - text: 'Because.

      We''ve already been over this.'
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: It's not fair
    name: Spartan Jack
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Mad
  - text: Life's not fair, Jack. It wasn't fair in ancient Sparta and it isn't fair
      now
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: I spent my whole life in this town until I met your father. You'll do just
      fine. It's got everything we need, it's safe... and just take a look around
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: I hate it already
    name: Spartan Jack
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 2
    face: Mad
  - text: 'Could you be grateful for once in your life?

      You do this every
      time'
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Mad
  - text: ...
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Blank
  - text: 'You won''t find any friends here with that attitude.

      Why do I even
      bother with you?'
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  - text: ...
    name: 
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Blank
  - text: Our stuff has already been moved to the house, there's no backing out now
    name: Mom
    character: {fileID: 0}
    pose: SittingDown
    cameraAngle: 4
    face: Confused
  turnToFace: 0
  snapPlayerPosition: 0
